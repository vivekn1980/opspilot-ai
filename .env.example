# --- apps/api/.env ---
# Local dev uses SQLite (zero setup). Swap DATABASE_URL to a Postgres
# connection string for anything beyond a laptop demo — see docs/ARCHITECTURE.md
# for the multi-tenant Postgres + RLS design this is meant to grow into.
DATABASE_URL="file:./dev.db"

# Required for the AI Log Analyzer / RCA Generator endpoints.
# Resolves from `ant auth login` if unset — see the Anthropic CLI docs.
ANTHROPIC_API_KEY=

PORT=4000

# --- apps/web/.env.local ---
NEXT_PUBLIC_API_URL=http://localhost:4000
