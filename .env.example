# --- apps/api/.env ---
# Postgres, one shared database with every organization's data isolated by
# organizationId (see src/prisma/tenant-scoping.extension.ts) — not a
# separate database per tenant. Local install:
# postgresql://<user>:<password>@localhost:5432/opspilot
DATABASE_URL=

# AI provider used for every AI feature is chosen at runtime in Settings
# (default: Kimi K3, free via TokenRouter). Only the key for whichever
# provider is active actually needs to be set.
TOKENROUTER_API_KEY=
ANTHROPIC_API_KEY=

# Optional: SEV1-on-create and SLA-breach alerts post here. Any Slack
# incoming webhook URL works; Discord/Teams webhooks that accept a plain
# { text } JSON body work too. Leave blank to disable notifications —
# nothing else in the app depends on this being set.
SLACK_WEBHOOK_URL=

# Required for real use. Signs session cookies — generate one with
# `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`.
# Falls back to a hardcoded dev-only value if unset (see src/auth/constants.ts)
# so local dev works out of the box, but that fallback must never be used
# anywhere shared or persistent.
JWT_SECRET=
# Must match the origin the frontend is served from — CORS only accepts
# credentialed (cookie-carrying) requests from this exact origin.
WEB_ORIGIN=http://localhost:3000

PORT=4000

# --- apps/web/.env.local ---
NEXT_PUBLIC_API_URL=http://localhost:4000
