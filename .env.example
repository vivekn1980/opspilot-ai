# --- apps/api/.env ---
# Local dev uses SQLite (zero setup). Swap DATABASE_URL to a Postgres
# connection string for anything beyond a laptop demo — see docs/ARCHITECTURE.md
# for the multi-tenant Postgres + RLS design this is meant to grow into.
DATABASE_URL="file:./dev.db"

# AI provider used for every AI feature is chosen at runtime in Settings
# (default: Kimi K3, free via TokenRouter). Only the key for whichever
# provider is active actually needs to be set.
TOKENROUTER_API_KEY=
ANTHROPIC_API_KEY=

PORT=4000

# --- apps/web/.env.local ---
NEXT_PUBLIC_API_URL=http://localhost:4000
