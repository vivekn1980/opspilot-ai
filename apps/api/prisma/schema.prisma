generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// SQLite has no native enum type, so severity/status are validated at the
// application layer (see src/incidents/constants.ts) rather than the DB layer.
// Swapping datasource to Postgres later can promote these back to real enums.
model Incident {
  id                  String    @id @default(cuid())
  title               String
  description         String
  severity            String    @default("SEV3")
  status              String    @default("OPEN")
  rawLogs             String?
  logAnalysis         String?
  rcaReport           String?
  // Set once an SLA-breach alert has been sent, so the periodic sweep in
  // NotificationsService never re-notifies for the same incident.
  slaBreachNotifiedAt DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
}

model Problem {
  id          String   @id @default(cuid())
  title       String
  description String
  status      String   @default("OPEN") // OPEN, IDENTIFIED, RESOLVED
  rootCause   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Change {
  id          String    @id @default(cuid())
  title       String
  description String
  riskLevel   String    @default("MEDIUM") // LOW, MEDIUM, HIGH
  status      String    @default("PROPOSED") // PROPOSED, APPROVED, SCHEDULED, COMPLETED, CANCELLED
  scheduledAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// AI-drafted from a resolved incident's RCA / log analysis.
model Sop {
  id               String   @id @default(cuid())
  title            String
  content          String
  sourceIncidentId String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

// Runbooks/wiki text the AI Chat with Documentation feature retrieves from.
// Retrieval is lexical (keyword overlap) for the MVP, not vector search —
// see docs/ARCHITECTURE.md's "AI & RAG Pipeline" for the target design.
model Doc {
  id        String   @id @default(cuid())
  title     String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ShiftHandover {
  id          String   @id @default(cuid())
  summary     String
  periodStart DateTime
  periodEnd   DateTime
  createdAt   DateTime @default(now())
}

// AI-drafted, customer-facing status update. An incident can have several
// over its lifecycle (opened, investigating, resolved), so this is a log,
// not a single field on Incident.
model CustomerUpdate {
  id         String   @id @default(cuid())
  incidentId String
  content    String
  createdAt  DateTime @default(now())
}

model Risk {
  id          String   @id @default(cuid())
  title       String
  description String
  likelihood  String   @default("MEDIUM") // LOW, MEDIUM, HIGH
  impact      String   @default("MEDIUM") // LOW, MEDIUM, HIGH
  status      String   @default("OPEN") // OPEN, MITIGATING, ACCEPTED, CLOSED
  mitigation  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// User pastes a raw metric time series (e.g. "date,value" lines); the AI
// narrative is the forecast/anomaly explanation, not a modeled prediction —
// there's no real metrics pipeline behind this in the MVP.
model CapacityReport {
  id         String   @id @default(cuid())
  metricName String
  rawData    String
  narrative  String
  createdAt  DateTime @default(now())
}

// Steps and step results are stored as JSON strings (SQLite has no native
// JSON/array column) — see RunbookStep / RunbookStepResult types in the API.
model Runbook {
  id          String   @id @default(cuid())
  title       String
  description String
  steps       String // JSON: RunbookStep[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model RunbookRun {
  id          String    @id @default(cuid())
  runbookId   String
  status      String    @default("IN_PROGRESS") // IN_PROGRESS, COMPLETED
  stepResults String // JSON: RunbookStepResult[]
  startedAt   DateTime  @default(now())
  completedAt DateTime?
}

model ExecutiveReport {
  id          String   @id @default(cuid())
  content     String
  periodStart DateTime
  periodEnd   DateTime
  createdAt   DateTime @default(now())
}

model ServiceReviewReport {
  id          String   @id @default(cuid())
  accountName String
  content     String
  periodStart DateTime
  periodEnd   DateTime
  createdAt   DateTime @default(now())
}

// Generic key-value app settings — currently just which LLM provider
// AiService routes through. Single row per key, no per-user scoping
// (the app has no auth/multi-tenancy yet).
model AppSetting {
  key   String @id
  value String
}

// Named metric time-series snapshots the AI Monitoring Assistant answers
// questions against. Same "paste it in" pattern as CapacityReport — there's
// no live metrics ingest pipeline in the MVP (see docs/ARCHITECTURE.md's
// integration hub for the target Datadog/Prometheus/CloudWatch connectors).
model Metric {
  id        String   @id @default(cuid())
  name      String
  rawData   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
