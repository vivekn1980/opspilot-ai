generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// SQLite has no native enum type, so severity/status are validated at the
// application layer (see src/incidents/constants.ts) rather than the DB layer.
// Swapping datasource to Postgres later can promote these back to real enums.
model Incident {
  id          String   @id @default(cuid())
  title       String
  description String
  severity    String   @default("SEV3")
  status      String   @default("OPEN")
  rawLogs     String?
  logAnalysis String?
  rcaReport   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Problem {
  id          String   @id @default(cuid())
  title       String
  description String
  status      String   @default("OPEN") // OPEN, IDENTIFIED, RESOLVED
  rootCause   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Change {
  id          String    @id @default(cuid())
  title       String
  description String
  riskLevel   String    @default("MEDIUM") // LOW, MEDIUM, HIGH
  status      String    @default("PROPOSED") // PROPOSED, APPROVED, SCHEDULED, COMPLETED, CANCELLED
  scheduledAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// AI-drafted from a resolved incident's RCA / log analysis.
model Sop {
  id               String   @id @default(cuid())
  title            String
  content          String
  sourceIncidentId String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

// Runbooks/wiki text the AI Chat with Documentation feature retrieves from.
// Retrieval is lexical (keyword overlap) for the MVP, not vector search —
// see docs/ARCHITECTURE.md's "AI & RAG Pipeline" for the target design.
model Doc {
  id        String   @id @default(cuid())
  title     String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ShiftHandover {
  id          String   @id @default(cuid())
  summary     String
  periodStart DateTime
  periodEnd   DateTime
  createdAt   DateTime @default(now())
}

// AI-drafted, customer-facing status update. An incident can have several
// over its lifecycle (opened, investigating, resolved), so this is a log,
// not a single field on Incident.
model CustomerUpdate {
  id         String   @id @default(cuid())
  incidentId String
  content    String
  createdAt  DateTime @default(now())
}
