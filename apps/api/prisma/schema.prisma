generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// SQLite has no native enum type, so severity/status are validated at the
// application layer (see src/incidents/constants.ts) rather than the DB layer.
// Swapping datasource to Postgres later can promote these back to real enums.
model Incident {
  id          String   @id @default(cuid())
  title       String
  description String
  severity    String   @default("SEV3")
  status      String   @default("OPEN")
  rawLogs     String?
  logAnalysis String?
  rcaReport   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
